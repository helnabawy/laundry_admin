# Postgres (see docker-compose.yml)
DATABASE_URL="postgresql://laundry:laundry@localhost:5433/laundry?schema=public"

# Signs the admin portal session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me"

# Signs the mobile app's Bearer tokens. Generate with: openssl rand -base64 32
MOBILE_JWT_SECRET="change-me"

# Development OTP. When set, every phone accepts this code and no SMS is sent.
DEV_OTP_CODE="1234"

# Public origin, used to build absolute URLs for uploaded images.
PUBLIC_BASE_URL="http://localhost:3000"

# Laundry the mobile API serves when the app doesn't name one (X-Vendor-Id).
# Optional: defaults to the oldest active laundry.
# DEFAULT_VENDOR_SLUG="main"

# Firebase Cloud Messaging: the service-account JSON (one line) from Firebase
# console → Project settings → Service accounts → Generate new private key.
# Unset in development: pushes are logged instead of sent.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# Payments. Only "mock" exists today: every provider (Network International,
# Telr, Tabby) is simulated by the hosted page at /pay/{token}.
PAYMENT_MODE="mock"
# Signs payment webhooks. Generate with: openssl rand -base64 32
PAYMENT_WEBHOOK_SECRET="change-me"
